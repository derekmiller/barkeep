[Unit]
Description=Daily TouchBistro report ingest
Documentation=file:/opt/barkeep/deploy/README.md

[Timer]
# Local time of the host (systemd reads the system timezone). TouchBistro mails
# the closed week on Sunday shortly after 07:00, so the run sits behind that and
# the week lands the same morning. Daily rather than Sunday-only because a late
# or missing report is then caught on the next firing instead of a week later;
# the poller is idempotent, so the other six runs are no-ops.
OnCalendar=*-*-* 07:30:00
RandomizedDelaySec=15min
# Catch up after the host was off at the scheduled time. The poller is
# idempotent, so a late run is a no-op rather than a duplicate load.
Persistent=true
Unit=barkeep-ingest.service

[Install]
WantedBy=timers.target
