[Unit]
Description=Ingest TouchBistro weekly report from IMAP
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# The service user must be in the docker group (or run this as root).
User=barkeep
WorkingDirectory=/opt/barkeep
ExecStart=/usr/bin/docker compose --profile ingest run --rm ingest
TimeoutStartSec=15min
