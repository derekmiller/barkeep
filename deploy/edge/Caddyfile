# Edge routing for the LAN. Names resolve through Pi-hole's local DNS records
# (one A record per name, all pointing at this host).
#
# `tls internal` means Caddy's own CA. Browsers trust it only after you install
# Caddy's root certificate (see compose.yaml in this directory). If you later
# own a public domain, replace `tls internal` with a DNS-01 challenge and the
# trust step disappears.
{
	# No email: ACME is not used for internal names.
	admin off
}

barkeep.roadkill.lan {
	tls internal
	reverse_proxy metabase:3000
}

# The bare host name is the machine, not an app. Send it to the first real
# service, and give this a dashboard once there are several.
roadkill.lan {
	tls internal
	redir https://barkeep.roadkill.lan{uri}
}
