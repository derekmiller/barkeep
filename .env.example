# Local Postgres used by docker compose.
DATABASE_URL=postgresql://barkeep:barkeep@localhost:5432/barkeep

# IMAP ingestion (optional).
IMAP_HOST=imap.gmail.com
# Authenticate as the real account, never as an alias.
IMAP_USER=owner@example.com
# 16-character Google app password (2-Step Verification required).
IMAP_PASSWORD=app-password-here
# Dedicated Gmail label / IMAP folder for report mail. Do not use INBOX.
IMAP_MAILBOX=SalesReports
# Optional server-side filters. Leave blank to match any sender/subject.
IMAP_SENDER=
IMAP_SUBJECT=
# Look back this many days on every run; 0 means no date bound.
# Duplicate reports are skipped by content hash, so a wide window is safe.
IMAP_SINCE_DAYS=21
