# Local Postgres used by docker compose and host-run tools.
# On a development workstation, publish it with:
#   docker compose -f compose.yaml -f compose.dev.yaml up -d db metabase
# Production (compose.yaml alone) does not publish Postgres.
DATABASE_URL=postgresql://barkeep:barkeep@localhost:5432/barkeep
# Alternative for Docker/systemd secrets: a file containing the DSN.
# DATABASE_URL_FILE=/run/secrets/database_url

# Postgres container credentials (compose defaults shown).
POSTGRES_DB=barkeep
POSTGRES_USER=barkeep
POSTGRES_PASSWORD=barkeep

# IMAP ingestion.
IMAP_HOST=imap.gmail.com
# Authenticate as the real account, never as an alias.
IMAP_USER=owner@example.com
# 16-character Google app password (2-Step Verification required).
# For Docker, prefer IMAP_PASSWORD_FILE pointing at a mounted secret instead.
IMAP_PASSWORD=app-password-here
# IMAP_PASSWORD_FILE=/run/secrets/imap_password
# Dedicated Gmail label / IMAP folder for report mail. Do not use INBOX.
IMAP_MAILBOX=SalesReports
# Required: only mail whose From address matches this may be ingested.
# Use a full address, or a bare domain to allow the whole domain.
IMAP_SENDER=reports@touchbistro.com
# Optional subject filter, in addition to the sender allowlist.
IMAP_SUBJECT=
# Look back this many days on every run; 0 means no date bound.
# Duplicate reports are skipped by content hash, so a wide window is safe.
IMAP_SINCE_DAYS=21
